{
  "name": "fhl",
  "version": "1.0.0",
  "description": "The full stack repo for all FHL related applications",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "sst build",
    "console": "sst console",
    "deploy:prod": "sst deploy --stage prod",
    "deploy:test": "sst deploy --stage test",
    "diagnostic": "sst diagnostic",
    "db": "pnpm --filter @fhl/core-next run db",
    "dev": "sst dev",
    "gen": "hygen",
    "local": "sst dev --stage local",
    "remove": "sst remove",
    "remove:local": "sst remove --stage local",
    "unlock": "sst unlock",
    "typecheck": "tsc --noEmit && tsc-alias -p tsconfig.json"
  },
  "dependencies": {
    "@graphql-tools/graphql-file-loader": "^8.0.0",
    "@graphql-tools/load": "^8.0.0",
    "sst": "catalog:"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.4.8",
    "@changesets/cli": "^2.26.2",
    "@stylistic/eslint-plugin-ts": "^1.7.0",
    "@tsconfig/node20": "^20.1.5",
    "@types/aws-lambda": "8.10.148",
    "@types/react": "18.2.14",
    "aws-cdk-lib": "2.91.0",
    "constructs": "10.2.69",
    "dotenv": "^16.3.1",
    "husky": "^8.0.3",
    "hygen": "^6.2.11",
    "prettier": "^2.8.8",
    "tsc-alias": "^1.8.7",
    "typescript": "^5.2.2"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "_moduleAliases": {
    "$": "dist"
  }
}
